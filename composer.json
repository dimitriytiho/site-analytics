{
  "name": "omegakontur/site-analytics",
  "description": "Агрегированные счётчики сайта и отчёты Filament для Laravel",
  "type": "library",
  "require": {
    "php": "^8.4",
    "filament/filament": "^5.1",
    "illuminate/database": "^12.0",
    "illuminate/support": "^12.0",
    "illuminate/http": "^12.0",
    "illuminate/cache": "^12.0",
    "illuminate/routing": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "Omegakontur\\SiteAnalytics\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Omegakontur\\SiteAnalytics\\SiteAnalyticsServiceProvider"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "laravel",
    "filament",
    "analytics",
    "statistics"
  ]
}
